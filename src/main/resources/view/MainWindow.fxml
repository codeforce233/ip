<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="600.0" prefWidth="440.0"
            stylesheets="@../css/main.css"
            xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="sage.gui.MainWindow">
    <children>
        <ScrollPane fx:id="scrollPane"
                    accessibleText="Conversation history"
                    fitToWidth="true"
                    hbarPolicy="NEVER"
                    pannable="true"
                    styleClass="dialog-scroll-pane"
                    AnchorPane.bottomAnchor="64.0"
                    AnchorPane.leftAnchor="0.0"
                    AnchorPane.rightAnchor="0.0"
                    AnchorPane.topAnchor="0.0">
            <content>
                <VBox fx:id="dialogContainer"
                      fillWidth="true"
                      spacing="6.0"
                      styleClass="dialog-container" />
            </content>
        </ScrollPane>
        <HBox alignment="CENTER"
              minHeight="64.0"
              prefHeight="64.0"
              spacing="8.0"
              styleClass="input-bar"
              AnchorPane.bottomAnchor="0.0"
              AnchorPane.leftAnchor="0.0"
              AnchorPane.rightAnchor="0.0">
            <children>
                <TextField fx:id="userInput"
                           accessibleHelp="Type a Sage command and press Enter."
                           accessibleText="Command input"
                           maxWidth="1.7976931348623157E308"
                           onAction="#handleUserInput"
                           promptText="Enter a command..."
                           styleClass="command-input"
                           HBox.hgrow="ALWAYS" />
                <Button fx:id="sendButton"
                        accessibleText="Send command"
                        defaultButton="true"
                        mnemonicParsing="true"
                        onAction="#handleUserInput"
                        prefWidth="88.0"
                        styleClass="send-button"
                        text="_Send" />
            </children>
        </HBox>
    </children>
</AnchorPane>
